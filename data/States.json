{"id":50,"autoRemovalTiming":0,"chanceByDamage":100,"traits":[],"iconIndex":76,"maxTurns":1,"message1":"","message2":"","message3":"","message4":"","minTurns":1,"motion":0,"name":"战斗状态","note":"<Custom Battle Effect>\nvar states = {};\nif (user.isActor()){\n    states = $gameMap.adamdata.user_states;\n    //封印师初始是指护盾\n    if(user._classId== 6){\n        user.addState(97);\n    }\n}else{\n    states = $gameMap.get_enemy_states();\n}\nvar state_max_id = $dataStates.length;\nvar new_state = {\n    \"id\":state_max_id,\n    \"autoRemovalTiming\":0,\n    \"chanceByDamage\":100,\n    \"traits\":[],\n    \"iconIndex\":16,\n    \"maxTurns\":1,\n    \"message1\":\"\",\n    \"message2\":\"\",\n    \"message3\":\"\",\n    \"message4\":\"\",\n    \"minTurns\":1,\n    \"motion\":0,\n    \"name\":\"叠加buff\",\n    \"note\":\"\",\n    \"overlay\":0,\n    \"priority\":50,\n    \"removeAtBattleEnd\":true,\n    \"removeByDamage\":false,\n    \"removeByRestriction\":false,\n    \"removeByWalking\":false,\n    \"restriction\":0,\n    \"stepsToRemove\":100\n}\nvar state_old = {};\nvar state_num = states.length;\nObject.keys(states).forEach(function(key) {\n    var value = states[key];\n    user.addState(key);\n    user.setStateCounter(key, value);\n    var state = $dataStates[key];\n    state_old = state;\n    for(var i = 1; i <= value; i++)\n    {\n        if((key>=11&&key<=20)||(key>=23&&key<=28)){\n            new_state.traits.push(state.traits[0]);\n            //state.traits = [];\n        }\n    }\n});\nvar new_state1 = {...state_old, ...new_state};\n$dataStates.push(new_state1);\nuser.addState(state_max_id);\nuser.setStateCounter(state_max_id, state_num);\n</Custom Battle Effect>\n\n//统一设置\n<Custom React Effect>\nif(value>0){\n    //检查攻击方是否为角色\n    if(attacker.isActor()){\n        var class_id = attacker._classId;\n        console.log('职业id:'+class_id);\n        switch(class_id){\n            case 1:\n                //战士\n                break;\n            case 2:\n             